# ansible-test results and scratch files (hundreds of MB after a run)
/tests/output/

# Collection artifacts from ansible-galaxy collection build
/compiled-builtin-*.tar.gz

# The compiled multi-call binary (multicall_<goos>_<goarch>). It is built by
# tests/build.py in CI and for releases, and compiled on demand by the action
# plugins when missing. Only the docs (.yml) and name placeholders (.meta) are
# tracked here. To commit the binary instead, delete these three lines and
# add a validate-modules!skip entry for the binary to tests/sanity/ignore-*.txt.
/plugins/modules/*
!/plugins/modules/*.yml
!/plugins/modules/*.meta

# Python
__pycache__/
*.py[cod]

# Go
*.test
*.out

# Editors and OS
.vscode/
.idea/
*.swp
*~
.DS_Store

# Written by ansible-test integration --local on every run
tests/integration/inventory
