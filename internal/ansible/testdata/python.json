    "\\"
   ]
  },
  {
   "in": "a\\",
   "err": "No escaped character"
  },
  {
   "in": "'open",
   "err": "No closing quotation"
  },
  {
   "in": "\"open",
   "err": "No closing quotation"
  },
  {
   "in": "",
   "out": []
  },
  {
   "in": "é ü",
   "out": [
